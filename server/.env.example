PORT=4000
JWT_SECRET=lux-salon-secret-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Firebase / Firestore Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Path or JSON string for Firebase Service Account Key
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Optional: If testing against Firestore emulator locally
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ----------------------------------------------------
# Email Notifications (Choose ANY 1 of these options)
# ----------------------------------------------------
# Method 1: Brevo (Sendinblue)
# 1. Sign up free at https://brevo.com
# 2. Get API key from Profile -> SMTP & API
# BREVO_API_KEY=xkeysib-your-key-here
# BREVO_SENDER_EMAIL=your-email@example.com

# Method 2: Resend API (Requires custom domain)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=Lux Beauty & Hair Salon <bookings@yourdomain.com>

# Method 3: Generic SMTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-login-email@example.com
# SMTP_PASS=your-smtp-master-password

# Method 4: Gmail SMTP with App Password
# EMAIL_USER=your-salon-email@gmail.com
# EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Salon owner/admin notification email (receives booking & order alerts)
ADMIN_NOTIFICATION_EMAIL=owner@example.com
